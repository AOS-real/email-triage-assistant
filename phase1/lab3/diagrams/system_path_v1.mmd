flowchart LR
    P["PERSON<br/>Opens inbox, checks a label,<br/>moves message back, gives a reason"]
    IN["INPUT<br/>Incoming email: sender, subject, body, attachments<br/>(IMPLEMENTED as test data)"]
    CTX[("CONTEXT / DATA<br/>Sender history and owner's past actions<br/>(SIMULATED: a small Python dict)")]
    EX["EXTRACT<br/>Deadline words and dates, sender status<br/>(IMPLEMENTED: regex rules, stand-in for an LLM)"]
    CL["CLASSIFY<br/>Needs you / Can wait<br/>(IMPLEMENTED: rules)"]
    WHY["GENERATE REASON<br/>Short 'why' label<br/>(IMPLEMENTED: template text)"]
    OUT["RESPONSE<br/>Message in section + 'why' label<br/>(SIMULATED: text output, not a real inbox)"]
    NEXT{"NEXT ACTION<br/>Person agrees, or taps<br/>'Move back'<br/>(SIMULATED: printed options)"}
    FB["CORRECTION<br/>'Why was this wrong?'<br/>Urgent deadline / Important sender / Other<br/>(IMPLEMENTED: correction handling)"]
    LEARN[("LEARN<br/>Add rule for similar messages<br/>(SIMULATED: rule list in memory)")]
    FALL["FALLBACK (v1)<br/>Missing or unclear info:<br/>decide from sender history alone,<br/>never ask or say what is missing<br/>(IMPLEMENTED: the classify rules)"]

    IN --> EX
    CTX --> EX
    EX --> CL --> WHY --> OUT --> P
    P --> NEXT
    NEXT -- "agrees" --> P
    NEXT -- "Move back" --> FB --> LEARN --> CL
    EX -. "missing info" .-> FALL
    FALL -. "v1: no special handling" .-> CL

    classDef impl fill:#d9f2d9,stroke:#2d6a2d,color:#111
    classDef sim fill:#fff2cc,stroke:#8a6d00,color:#111
    classDef plan fill:#e8e8e8,stroke:#555,color:#111,stroke-dasharray:4 3
    classDef person fill:#cfe2ff,stroke:#1a4a8a,color:#111
    class IN,EX,CL,WHY,FALL impl
    class CTX,OUT,LEARN sim
    class P,NEXT,FB person
